# eap-worker environment (example; no secrets here — never commit a real key).

# App DB (runs, execution_events, side_effects, fake_external_tickets) and DBOS system DB.
EAP_DATABASE_URL=postgresql+psycopg://eap_app:eap_app_password@localhost:54329/eap_app
EAP_DBOS_URL=postgresql://eap_dbos:eap_dbos_password@localhost:54329/eap_dbos
# EAP_DBOS_SYSTEM_SCHEMA=dbos
EAP_APP_VERSION=m1
EAP_EXECUTOR_ID=worker-1
# EAP_ALLOWED_TOOLS=tickets.create,clock.now   # default: every tool in the runtime registry

# Model provider 'litellm' (OpenAI-compatible gateway), e.g. spec model {provider: litellm, name: qwen3.8-thinking}.
# Base URL: EAP_LITELLM_BASE_URL, falling back to OPENAI_BASE_URL.
#   Local dev: SSH tunnel http://127.0.0.1:14001/v1 (no request time limit).
#   Public:    https://llm-gateway.example.com/v1 is behind a proxy that cuts any single request at ~300 s.
EAP_LITELLM_BASE_URL=http://127.0.0.1:14001/v1
# API key: EAP_LITELLM_API_KEY, falling back to LITELLM_API_KEY. Leave empty here; load it into the
# shell from sops instead of writing it to any file:
#   export LITELLM_API_KEY="$(sops -d <your-secrets-file> | jq -r .LITELLM_API_KEY)"
EAP_LITELLM_API_KEY=

# Crash-injection hook (tests only): model_request | after_tool_call | after_event_write
# EAP_CRASH_AT=
# EAP_CRASH_EVENT_KEY=*
# EAP_CRASH_MARKER=/tmp/eap-crash-once
