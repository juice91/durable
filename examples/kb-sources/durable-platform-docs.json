{
  "repository": "juice91/durable",
  "ref": "main",
  "include": [
    "README.md",
    "docs/**",
    "examples/**",
    "apps/**",
    "packages/**/src/**",
    "packages/*/pyproject.toml",
    "deploy/scripts/**",
    "deploy/docker/**",
    "deploy/k8s/*.yaml"
  ],
  "exclude": [
    "docs/superpowers/plans/**",
    "docs/architect-dogfood-*",
    "docs/reviews/**",
    "docs/spikes/**",
    "**/CHANGELOG*",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/__pycache__/**",
    "**/__snapshots__/**",
    "**/*.snap",
    "**/*.min.js",
    "**/*.d.ts",
    "**/generated/**",
    "**/migrations/**",
    "**/fixtures/**",
    "**/package.json",
    "**/package-lock.json",
    "**/tsconfig*.json",
    "**/*.lock",
    "**/pnpm-lock.yaml",
    "deploy/k8s/secret.template.yaml",
    "**/*_tests/**",
    "**/tests/**",
    "**/test_*.py",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "map": [
    {"match": "**/*_tests/**", "metadata": {"kind": "test"}},
    {"match": "**/tests/**", "metadata": {"kind": "test"}},
    {"match": "**/test_*.py", "metadata": {"kind": "test"}},
    {"match": "**/*.test.ts", "metadata": {"kind": "test"}},
    {"match": "**/*.test.tsx", "metadata": {"kind": "test"}},
    {"match": "**/*.spec.*", "metadata": {"kind": "test"}},
    {"match": "README.md", "metadata": {"kind": "guide", "audience": "overview"}},
    {"match": "docs/superpowers/specs/**", "metadata": {"kind": "spec", "status": "design"}},
    {"match": "docs/architect*.md", "metadata": {"kind": "guide", "topic": "architect"}},
    {"match": "docs/api-layering.md", "metadata": {"kind": "reference", "topic": "architecture"}},
    {"match": "docs/providers/**", "metadata": {"kind": "reference", "topic": "providers"}},
    {"match": "docs/tools/**", "metadata": {"kind": "reference", "topic": "tools"}},
    {"match": "docs/workflows/**", "metadata": {"kind": "guide", "topic": "workflows"}},
    {"match": "docs/agents/**", "metadata": {"kind": "guide", "topic": "agents"}},
    {"match": "docs/adr/**", "metadata": {"kind": "adr"}},
    {"match": "docs/**", "metadata": {"kind": "guide"}},
    {"match": "examples/**", "metadata": {"kind": "example"}},
    {"match": "apps/api/**", "metadata": {"kind": "code", "component": "api"}},
    {"match": "apps/worker/**", "metadata": {"kind": "code", "component": "worker"}},
    {"match": "apps/studio/**", "metadata": {"kind": "code", "component": "studio"}},
    {"match": "packages/**", "metadata": {"kind": "code", "component": "package"}},
    {"match": "deploy/**", "metadata": {"kind": "code", "component": "deploy"}}
  ],
  "max_bytes": 262144,
  "document_policy": {
    "types": ["md", "json", "yaml", "yml", "py", "ts", "tsx", "js", "mjs", "sh", "toml", "sql", "dockerfile"],
    "delete_missing": true
  },
  "key_prefix": "durable:"
}
