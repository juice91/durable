# Copy to .env.local (git-ignored) and fill in. Read by the server only; nothing here reaches the browser.

# The PydanticOS API origin, without /api/v1.
PYDANTICOS_API_URL=http://127.0.0.1:8000

# A tenant API key (Studio > Settings > API keys, or POST /api/v1/api-keys on a dev-mode API).
PYDANTICOS_API_KEY=pos_<id>_<secret>

# The published agent to chat with (served to CopilotKit as "pydanticosAgent").
PYDANTICOS_AGENT_ID=

# Optional: a published workflow (served as "pydanticosWorkflow").
# PYDANTICOS_WORKFLOW_ID=

# Optional: more agents, as CopilotKit agent name = PydanticOS agent id, comma-separated.
# PYDANTICOS_AGENTS=support=<agentId>,billing=<agentId>

# CopilotKit's runtime telemetry is on by default.
COPILOTKIT_TELEMETRY_DISABLED=true
