# Development Database Configuration
# WARNING: These are placeholder passwords for local development only.
# Do NOT use in production.

# Admin user for database management
POSTGRES_USER=eap_admin
POSTGRES_PASSWORD=eap_admin_password

# Application database connection (use with psycopg driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
EAP_DATABASE_URL=postgresql+psycopg://eap_app:eap_app_password@localhost:54329/eap_app

# DBOS system database connection (uses native postgresql driver)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DBOS_SYSTEM_DATABASE_URL=postgresql://eap_dbos:eap_dbos_password@localhost:54329/eap_dbos
