# Optional settings for `docker compose up` (docs/quickstart-compose.md). Copy to .env, which git ignores, and
# uncomment what you need. The platform starts without any of them; Studio then says how to add a model provider.
# After a change: docker compose up -d
#
# Do not add keys of the platform itself here: the stack makes its own (sign-in, encryption, database passwords).

# --- Model providers (any one is enough) ----------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# An OpenAI-compatible gateway (LiteLLM and others); its models are named litellm:<model>.
# EAP_LITELLM_BASE_URL=http://host.docker.internal:4000/v1
# EAP_LITELLM_API_KEY=

# Which models people may pick (default: every model of the three providers above).
# EAP_ALLOWED_MODELS=anthropic:*,openai:*,litellm:*

# Embeddings, for knowledge bases and semantic recall (provider:name=<dimensions>: 768, 1024 or 1536).
# openai:* embedding models use their own key.
# EAP_OPENAI_EMBEDDING_API_KEY=
# EAP_ALLOWED_EMBEDDING_MODELS=openai:text-embedding-3-small=1536
# EAP_LITELLM_EMBEDDING_BASE_URL=
# EAP_LITELLM_EMBEDDING_API_KEY=

# --- This machine ---------------------------------------------------------------------------------------------------
# Studio's port on 127.0.0.1.
# EAP_STUDIO_PORT=3000

# --- Observability (Grafana on http://localhost:3001) ---------------------------------------------------------------
# COMPOSE_PROFILES=observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
# EAP_LOKI_URL=http://lgtm:3100
# EAP_GRAFANA_PORT=3001

# --- Development without containers (scripts/dev-up.sh; the defaults work) ------------------------------------------
# POSTGRES_USER=eap_admin
# POSTGRES_PASSWORD=eap_admin_password
# EAP_DATABASE_URL=postgresql+psycopg://eap_app:eap_app_password@localhost:54329/eap_app
# DBOS_SYSTEM_DATABASE_URL=postgresql://eap_dbos:eap_dbos_password@localhost:54329/eap_dbos
