# Development environment configuration (gitignored)
# Copy to .dev.env and fill in values (or use EAP_LITELLM_API_KEY_CMD)

# Model provider (litellm) OpenAI-compatible API
# EAP_LITELLM_BASE_URL=http://127.0.0.1:14001/v1
# LITELLM_API_KEY=your-api-key-here

# Or fetch key from external source (never commit the result)
# EAP_LITELLM_API_KEY_CMD='sops -d ~/.config/sops/secrets.json | jq -r .LITELLM_QWEN38_THINKING_API_KEY'

# App configuration (defaults in code, typically fine)
# EAP_AUTH_MODE=dev
# EAP_APP_VERSION=m2
# EAP_EXECUTOR_ID=worker-1
# EAP_ALLOWED_MODELS=*

# Database URLs (defaults connect to local docker)
# EAP_DATABASE_URL=postgresql+psycopg://eap_app:eap_app_password@localhost:54329/eap_app
# EAP_DBOS_URL=postgresql://eap_dbos:eap_dbos_password@localhost:54329/eap_dbos

# Worker backoff (seconds)
# EAP_WORKER_BACKOFF=2

# Postgres credentials (if different from defaults)
# POSTGRES_USER=eap_admin
# POSTGRES_PASSWORD=eap_admin_password
