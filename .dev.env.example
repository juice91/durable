# Development environment configuration (gitignored)
# Copy to .dev.env and fill in values (or use EAP_LITELLM_API_KEY_CMD)

# Model provider (litellm) OpenAI-compatible API
# EAP_LITELLM_BASE_URL=http://127.0.0.1:14001/v1
# LITELLM_API_KEY=your-api-key-here

# Or fetch key from external source (never commit the result)
# EAP_LITELLM_API_KEY_CMD='sops -d ~/.config/sops/secrets.json | jq -r .LITELLM_QWEN38_THINKING_API_KEY'
# Provider 'anthropic' (Claude models, e.g. anthropic:claude-opus-5-5): command that prints the API key;
# dev-up exports it as ANTHROPIC_API_KEY. Add the model to EAP_ALLOWED_MODELS to publish agents using it.
# EAP_ANTHROPIC_API_KEY_CMD='sops -d ~/.config/sops/secrets.json | jq -r .Pikza_Claude_Key'

# App configuration (defaults in code, typically fine)
# EAP_AUTH_MODE=dev
# EAP_APP_VERSION=m2
# EAP_EXECUTOR_ID=worker-1
# EAP_ALLOWED_MODELS=*

# Database URLs (defaults connect to local docker)
# EAP_DATABASE_URL=postgresql+psycopg://eap_app:eap_app_password@localhost:54329/eap_app
# EAP_DBOS_URL=postgresql://eap_dbos:eap_dbos_password@localhost:54329/eap_dbos

# Platform key for encrypted secrets (MCP server header values). Required by the API and the worker
# to store or use header secrets: an unset key answers 503 on those requests, a malformed one stops
# startup. Base64 of exactly 32 random bytes; generate one (never commit it) with:
#   python -c 'import base64,os; print(base64.b64encode(os.urandom(32)).decode())'
# Rotation: put the new key here and the previous one in EAP_SECRETS_OLD_KEYS (comma-separated);
# old ciphertexts keep decrypting by key id, new ones use the new key.
# EAP_SECRETS_KEY=
# EAP_SECRETS_OLD_KEYS=

# MCP servers: outbound policy dev allowlist. Hosts listed here (exact names or IPs, comma-separated)
# may use http and resolve to private/loopback addresses. Local development and tests only.
# EAP_MCP_DEV_ALLOW_HOSTS=127.0.0.1
# Bound on POST /api/v1/mcp-servers/{id}/test (seconds, default 10, max 30).
# EAP_MCP_TEST_TIMEOUT_SECONDS=10

# Worker backoff (seconds)
# EAP_WORKER_BACKOFF=2

# OpenTelemetry: traces (Tempo) and logs (Loki) over OTLP/HTTP to the LGTM container. Unset = off.
# Service names are fixed per process (eap-api, eap-worker).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Postgres credentials (if different from defaults)
# POSTGRES_USER=eap_admin
# POSTGRES_PASSWORD=eap_admin_password
