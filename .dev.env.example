# Development environment configuration (gitignored)
# Copy to .dev.env and fill in values (or use EAP_LITELLM_API_KEY_CMD)

# Model provider (litellm) OpenAI-compatible API
# EAP_LITELLM_BASE_URL=http://127.0.0.1:14001/v1
# LITELLM_API_KEY=your-api-key-here

# Or fetch key from external source (never commit the result)
# EAP_LITELLM_API_KEY_CMD='sops -d ~/.config/sops/secrets.json | jq -r .LITELLM_QWEN38_THINKING_API_KEY'
# Provider 'anthropic' (Claude models, e.g. anthropic:claude-opus-5-5): command that prints the API key;
# dev-up exports it as ANTHROPIC_API_KEY. Add the model to EAP_ALLOWED_MODELS to publish agents using it.
# EAP_ANTHROPIC_API_KEY_CMD='sops -d ~/.config/sops/secrets.json | jq -r .Pikza_Claude_Key'

# App configuration (defaults in code, typically fine)
# EAP_AUTH_MODE=dev
# Auth mode (AGUI.9): `dev` = the local bearer dev:<tenant>:<user> on every route plus API keys on
# /api/v1/ag-ui/*; `api_key` = tenant API keys on /api/v1/ag-ui/* are the only credential (every other
# route is 401; keys are created by a dev-mode API). Anything else, unset included, refuses to start.
# EAP_AUTH_MODE=api_key
# IAM plug-ins (docs/iam.md): `dev` defaults EAP_IAM_IDENTITY=apikey,devloopback and EAP_IAM_POLICY=openaccess. The dev bearer
# is accepted only from a loopback TCP peer, which uvicorn on the host (127.0.0.1) and `kubectl port-forward` are.
# EAP_IAM_IDENTITY=apikey,devloopback
# EAP_IAM_POLICY=openaccess
# Extra browser origins allowed by CORS on /api/v1/ag-ui/* only (comma-separated scheme://host[:port];
# default none; `*` refused). Studio's origins are always allowed. Server-side callers need no entry.
# EAP_AGUI_CORS_ORIGINS=https://app.example.com
# DBOS application version (default m1). It stays m1 through milestone 3: checkpoints recorded by
# earlier workers stay recoverable, and the new workflow functions have new names
# (eap.workflow_run, eap.workflow_branch), so they need no version bump.
# EAP_APP_VERSION=m1
# EAP_EXECUTOR_ID=worker-1
# EAP_ALLOWED_MODELS=*
# Embedding model allowlist (API and worker; knowledge bases and semantic recall): comma-separated
# provider:name=<dims> entries, dims one of 768, 1024, 1536, or provider:* (unset = test:* only).
# EAP_ALLOWED_EMBEDDING_MODELS=litellm:Qwen3-VL-Embedding-8B-mlx-8bit=1024,test:*
# Optional per-model query instruction (JSON object; queries only, documents are embedded as-is):
# EAP_EMBEDDING_QUERY_INSTRUCTIONS='{"litellm:Qwen3-VL-Embedding-8B-mlx-8bit": "Given a question, retrieve passages that answer it"}'
# Knowledge bases (API, RM.7): request body cap of the document upload route (default 5 MiB), and
# the per-run embedding token budget (the worker enforces it; the reindex dry run reports it).
# A reindex re-embeds the whole knowledge base in ONE run, so the 2M default fails a reindex above
# roughly 4k chunks (512-token chunks) to 16k chunks (128-token chunks). Sizing rule: set it to at
# least 1.25 x the largest knowledge base's reindex dry-run `approx_tokens` (or chunk_count x
# chunking.max_tokens x 1.25), and keep it below what one run may cost you.
# EAP_KB_MAX_DOCUMENT_BYTES=5242880
# EAP_KB_MAX_INGEST_TOKENS=2000000
# Audit (RM.9 forget-resource): the forget audit record logs a short hash of the resource id, never
# the id itself (it may be an email). Set a per-deployment secret so the hash is HMAC-SHA256 keyed
# with it (a guessable id cannot be looked up offline); unset, it is a plain SHA-256 prefix.
# EAP_AUDIT_HASH_SALT=
# Worker ingest (RM.10): chunks per embedding batch step of eap.kb_ingest (default 64; also capped at
# about 100k approximate tokens per batch, and at most 128 chunks: P1.C5 checkpoints the batch's
# vectors in eap.kb_embed_call).
# EAP_KB_EMBED_BATCH_CHUNKS=64
# Worker: at most this many knowledge base ingest/reindex runs at once per worker process (their
# own DBOS queue, eap-kb-ingest; default 2).
# EAP_KB_INGEST_CONCURRENCY=2
# Native formats (RAG P1; eap_knowledge.ExtractLimits, bounds in brackets). Upload caps, checked on
# the decoded bytes: PDF and other binary uploads (sent as content_base64) [1 B..100 MiB], and
# YAML/JSON [1 B..64 MiB, never above EAP_KB_MAX_DOCUMENT_BYTES]. Worker sandbox: at most this many
# PDF pages [1..20000]; per extraction CPU seconds [1..3600] (wall timeout = 2 x CPU); address space
# in MB [256..65536] (Linux only, macOS has no working RLIMIT_AS); concurrent extractions per worker
# [1..64].
# EAP_KB_MAX_BINARY_BYTES=26214400
# EAP_KB_MAX_STRUCTURED_BYTES=2097152
# EAP_KB_MAX_PDF_PAGES=2000
# EAP_KB_EXTRACT_CPU_SECONDS=60
# EAP_KB_EXTRACT_MEMORY_MB=1024
# EAP_KB_EXTRACT_CONCURRENCY=2
# RAG P1.A4 (API): binary (base64 PDF) uploads one API process decodes and checks at once [1..64];
# each holds its decoded bytes (up to EAP_KB_MAX_BINARY_BYTES), and a waiting one answers 503 after 30 s.
# EAP_KB_BINARY_UPLOAD_CONCURRENCY=4
# Retrieval (RM.11): when the shared HNSW index returns fewer than top_k hits and the attached
# knowledge bases hold at most this many active chunks, the search runs again exactly (default
# 20000; 0 turns the fallback off).
# EAP_KB_EXACT_SEARCH_MAX_CHUNKS=20000
# Worker embedding client (RM.6). litellm:* embedding models may use another gateway URL or virtual
# key than chat. They fall back to EAP_LITELLM_BASE_URL / EAP_LITELLM_API_KEY as a PAIR: when
# EAP_LITELLM_EMBEDDING_BASE_URL is set (to another URL than the chat one), EAP_LITELLM_EMBEDDING_API_KEY
# is required and the chat key is never sent there. Keys are secrets: load them from sops into the
# environment, never into a file.
# EAP_LITELLM_EMBEDDING_BASE_URL=https://llm-gateway.example.com/v1
# EAP_LITELLM_EMBEDDING_API_KEY=
# openai:* embedding models call api.openai.com directly (never OPENAI_BASE_URL) with this key only
# (OPENAI_API_KEY is not used: here it may be a LiteLLM virtual key).
# EAP_OPENAI_EMBEDDING_API_KEY=
# Caps on one provider embedding request (a larger call is split): inputs and approximate tokens
# (ceil(len / 4)); request timeout in seconds (transport retries are off, the DBOS step retries).
# EAP_EMBEDDING_MAX_BATCH_INPUTS=32
# EAP_EMBEDDING_MAX_BATCH_TOKENS=16384
# EAP_EMBEDDING_TIMEOUT_S=120
# Semantic recall (RM.14): deadline in seconds of each attempt of the pre-turn recall query embedding
# (at most 2 attempts), which delays the answer; on timeout the turn runs without the recall block.
# EAP_RECALL_TIMEOUT_S=8
# Live check only (apps/worker/worker_tests/test_live_litellm.py): an allowlist entry for the model.
# EAP_LIVE_EMBEDDING_MODEL=litellm:Qwen3-VL-Embedding-8B-mlx-8bit=1024
# Platform tool allowlist (API and worker): comma-separated tool ids, e.g. tickets.create,clock.now.
# Unset = every catalog tool is allowed; set but empty = none. Publishing an agent or workflow, and
# a tool test run, refuse a tool outside it (422).
# EAP_ALLOWED_TOOLS=

# Database URLs (defaults connect to local docker)
# EAP_DATABASE_URL=postgresql+psycopg://eap_app:eap_app_password@localhost:54329/eap_app
# EAP_DBOS_URL=postgresql://eap_dbos:eap_dbos_password@localhost:54329/eap_dbos

# Platform key for encrypted secrets (MCP server header values). Required by the API and the worker
# to store or use header secrets: an unset key answers 503 on those requests, a malformed one stops
# startup. Base64 of exactly 32 random bytes; generate one (never commit it) with:
#   python -c 'import base64,os; print(base64.b64encode(os.urandom(32)).decode())'
# Rotation: put the new key here and the previous one in EAP_SECRETS_OLD_KEYS (comma-separated);
# old ciphertexts keep decrypting by key id, new ones use the new key.
# EAP_SECRETS_KEY=
# EAP_SECRETS_OLD_KEYS=

# MCP servers: outbound policy dev allowlist. Hosts listed here (exact names or IPs, comma-separated)
# may use http and resolve to private/loopback addresses. Local development and tests only.
# EAP_MCP_DEV_ALLOW_HOSTS=127.0.0.1
# Bound on POST /api/v1/mcp-servers/{id}/test (seconds, default 10, max 30).
# EAP_MCP_TEST_TIMEOUT_SECONDS=10
# Worker: bound on one MCP connect + operation (tool discovery or one call), seconds; default 60,
# clamped to [1, 600].
# EAP_MCP_TIMEOUT_SECONDS=

# Workflow runs (worker). Each knob is read once when a run starts and checkpointed with it, so a
# restart with other values never changes a run already started. Defaults in code are for production.
# Seconds per `timeout_hours` hour of an approval step; default 3600 (tests shorten it).
# EAP_WORKFLOW_HOUR_SECONDS=
# How often a waiting approval re-checks its decision if a wake-up was lost, seconds; default 3600.
# EAP_APPROVAL_POLL_SECONDS=
# Both also apply to an agent's tool approvals (`approvals.timeout_hours`, AC.6), recorded by eap.start_run.
# Largest step output (bytes of JSON); default 32768 (32 KiB). Larger fails the step.
# EAP_WORKFLOW_MAX_STEP_OUTPUT_BYTES=
# Total of all step outputs of one run (bytes of JSON); default 1048576 (1 MiB).
# EAP_WORKFLOW_MAX_CONTEXT_BYTES=
# No step starts once a run is older than this, seconds; default 1209600 (14 days).
# EAP_WORKFLOW_MAX_RUN_SECONDS=
# Workflow loop caps, checked by the API at publish and run start (LP.5); drafts may exceed them.
# Whole numbers only; a malformed or out-of-bounds value fails API startup.
# Largest max_items / max_iterations of one loop step; default 100, 1 to 1000.
# EAP_WORKFLOW_MAX_LOOP_ITERATIONS=
# Largest static step-execution bound of one run (loops multiplied out); default 2000, 1 to 1000000.
# EAP_WORKFLOW_MAX_STEP_EXECUTIONS=
# Largest product of nested foreach concurrency in one run; default 8, 1 to 64.
# EAP_WORKFLOW_MAX_RUN_CONCURRENCY=
# (LP.11) EAP_WORKFLOW_LOOPS_PREVIEW is gone: loop and foreach steps and `limits` are open for good.
# Deploy note: a loop or foreach run (or a run with `limits`) started under the preview and still
# in flight when the LP.11 worker starts fails to recover (each iteration, a foreach window, and a
# top-level agent or evaluate step under `limits` gained the eap.workflow_loop_tick step): drain or
# cancel (POST /runs/{id}/cancel) every such run before that upgrade. Runs with no loop, no foreach
# and no `limits` are fine.
# (worker, LP.7) The worker records the three caps above with each run and re-checks the last two
# for a spec with loops. It also has two of its own, read once per run like the knobs above:
# Largest output of one loop step (bytes of JSON); default 262144 (256 KiB).
# EAP_WORKFLOW_MAX_LOOP_OUTPUT_BYTES=
# Largest loop state carried between iterations (bytes of JSON); default 16384 (16 KiB).
# EAP_WORKFLOW_MAX_LOOP_STATE_BYTES=

# Model prices for usage cost (worker): the operator override file, keyed by `provider:name` or
# `provider:*`, USD per million tokens. Default: config/model-prices.json at the repository root
# (prices test:* and litellm:* at 0). Other direct providers fall back to genai-prices. A relative
# path is resolved against the repository root; if the file set here does not exist, nothing is
# priced (the worker logs an error) rather than falling back to genai-prices.
# EAP_MODEL_PRICES_FILE=config/model-prices.json

# Observational memory (worker, P1.C6): the reflector's input cap in approximate tokens (default
# 32000, at least 1000, never below 2 x the spec's reflect_after_tokens nor reflect_after_tokens +
# the largest active observation, so a normal reflection is never cut). When reflection keeps
# failing and the backlog passes it, only the newest active observations within the cap are sent
# to the reflector; the older ones are REMOVED from the agent's memory by the reflection (kept as
# superseded rows), with a memory_observe_trimmed event. Lowering it discards memory sooner.
# EAP_MEMORY_MAX_ACTIVE_OBSERVATION_TOKENS=32000

# Memory retention (worker, RM.15): the scheduled DBOS workflow eap.memory_retention deletes memory
# older than N days, tenant by tenant in batches. All unset = this worker schedules nothing (and
# leaves a schedule other workers stored); EAP_MEMORY_RETENTION_DAYS=off removes the shared
# schedule. Configure every worker alike (a differing stored schedule is logged as a warning).
# EAP_MEMORY_RETENTION_DAYS covers message embeddings, observations and conversation-
# scoped working memory; a per-kind variable overrides it (a number of days, 1 to 36500, or `keep`). Resource-
# scoped working memory (the user's long-lived note) is swept only when its own variable is set.
# Old observations keep a text-free marker so their turns stay covered (not re-observed).
# Conversations, runs, forget watermarks and knowledge bases are never swept. Validated and applied
# at worker start (a bad value stops the worker).
# EAP_MEMORY_RETENTION_DAYS=
# EAP_MEMORY_RETENTION_EMBEDDING_DAYS=
# EAP_MEMORY_RETENTION_OBSERVATION_DAYS=
# EAP_MEMORY_RETENTION_WORKING_MEMORY_DAYS=
# EAP_MEMORY_RETENTION_RESOURCE_WORKING_MEMORY_DAYS=
# Cron (UTC; 5 fields, or 6 with seconds first); default daily at 03:00.
# EAP_MEMORY_RETENTION_SCHEDULE=0 3 * * *
# Rows (embeddings, resource notes) or conversations (observations, conversation notes) per batch;
# default 500, at most 10000. Each batch is one transaction and one DBOS step.
# EAP_MEMORY_RETENTION_BATCH_SIZE=500
# Unsent chat uploads expire after this many hours (default 24); the cron (seconds first, default
# daily 03:30 UTC) can be `off`.
# EAP_ATTACHMENT_ORPHAN_HOURS=24
# EAP_ATTACHMENT_RETENTION_SCHEDULE=0 30 3 * * *
# Steps per run (tenant pages plus batches), shared round-robin by the kinds; default 2000. The
# rest waits for the next run.
# EAP_MEMORY_RETENTION_MAX_STEPS=2000

# Cancel reconciler (eap.cancel_reconcile, workflow loops D12): finishes a POST /runs/{id}/cancel
# the API could not finish. Cron with seconds first; default every 60 s; `off` removes it.
# EAP_CANCEL_RECONCILE_SCHEDULE=0 * * * * *
# Seconds a cancel request must be old before the sweep takes it over; default 30.
# EAP_CANCEL_RECONCILE_AFTER_SECONDS=30
# Most runs finished per tick (oldest request first); default 100, at most 1000.
# EAP_CANCEL_RECONCILE_LIMIT=100

# Worker backoff (seconds)
# EAP_WORKER_BACKOFF=2

# OpenTelemetry: traces (Tempo) and logs (Loki) over OTLP/HTTP to the LGTM container. Unset = off.
# Service names are fixed per process (eap-api, eap-worker).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Loki HTTP API for the API's log search (GET /api/v1/logs). dev-up defaults it to the LGTM
# container's Loki, published on 127.0.0.1:3100. Unset = log search answers 503.
# EAP_LOKI_URL=http://127.0.0.1:3100
# Log search bounds: concurrent Loki queries per API process (default 4; more → 503 busy) and
# seconds per query (default 10, clamped to 1-60).
# EAP_LOKI_MAX_QUERIES=4
# EAP_LOKI_TIMEOUT_SECONDS=10

# Postgres credentials (if different from defaults)
# POSTGRES_USER=eap_admin
# POSTGRES_PASSWORD=eap_admin_password

# Postgres data volume guard (scripts/dev-lib.sh postgres_volume_guard): when no eap_postgres
# container exists, dev-up/dev-db refuse to create one while another *_postgres_data volume exists,
# since the compose project (and so the volume) differs between machines. Set to 1 to accept the
# default project's volume anyway, e.g. when the other volumes belong to unrelated projects.
# EAP_POSTGRES_ALLOW_DEFAULT_VOLUME=1
