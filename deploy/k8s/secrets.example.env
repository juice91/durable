# Copy outside the repository, fill each value, then pass it to deploy/scripts/up.sh --secrets-env.
POSTGRES_PASSWORD=
EAP_APP_DATABASE_PASSWORD=
EAP_DBOS_DATABASE_PASSWORD=
EAP_DATABASE_URL=
EAP_DBOS_URL=
EAP_SECRETS_KEY=
EAP_LITELLM_API_KEY=
EAP_LITELLM_EMBEDDING_API_KEY=
EAP_AUDIT_HASH_SALT=
EAP_BLOB_S3_ACCESS_KEY=
EAP_BLOB_S3_SECRET_KEY=
# Optional: Cloudflare Workers AI token (Workers AI read and run), with EAP_CLOUDFLARE_ACCOUNT_ID in the ConfigMap.
CLOUDFLARE_API_TOKEN=
# Optional: Cloudflare Tunnel connector token (for your public hostname). Empty keeps cloudflared at 0 replicas.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional: identity (ZITADEL) and authorization (OpenFGA), namespace iam. Leave a service's fields absent (or empty) to
# keep it at 0 replicas; set all of a service's fields or none. deploy/README.md, "Identity (ZITADEL) and authorization (OpenFGA)".
# ZITADEL: master key of exactly 32 characters (losing it makes ZITADEL's encrypted data unreadable), the database
# password (letters, digits and ._~- only), the first admin's username and its INITIAL password (change forced at first sign-in).
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_USERNAME=
ZITADEL_ADMIN_PASSWORD=
# OpenFGA: database password (letters, digits and ._~- only) and the preshared API key (same characters, 16 or more).
OPENFGA_DB_PASSWORD=
OPENFGA_PRESHARED_KEY=
# Optional: ZITADEL sign-in and members for the platform (the values `python -m eap_iam_zitadel.bootstrap` prints). Leave
# them out to keep the zitadel plug-in dormant. The machine key is the key JSON on ONE line.
EAP_ZITADEL_PROJECT_ID=
EAP_ZITADEL_ORG_TENANT_MAP=
EAP_ZITADEL_STUDIO_CLIENT_ID=
EAP_ZITADEL_MACHINE_KEY=
